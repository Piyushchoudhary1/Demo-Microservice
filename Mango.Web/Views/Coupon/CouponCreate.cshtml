@model CouponDto

<form asp-action="CouponCreate">
    <br />
    <div class="container border p-3 login-container">
        <h1 class="text-white text-center login-header">Create Coupon</h1>

        <div class="row">
            <div class="col-2">
                <label class="control-label pt-2 label coupon-label"> Coupon Code</label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="CouponCode" class="form-control input" />
                <span asp-validation-for="CouponCode" class="text-danger"></span>
            </div>
            <div class="col-2">
                <label class="control-label pt-2 coupon-label label" >Discount Amount</label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="DiscountAmount" class="form-control input" />
                <span asp-validation-for="DiscountAmount" class="text-danger"></span>
            </div>
            <div class="col-2">
                <label class="control-label pt-2 coupon-label label" >Minimum Amount</label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="MinAmount" class="form-control input" />
                <span asp-validation-for="MinAmount" class="text-danger"></span>
            </div>
            
            <div class="adjacent-buttons">
            <div class="col-5 offset-2">

                <a asp-action="CouponIndex" class="btn-primary btn form-control button-sub">Back to List</a>
            </div>
            <div class="col-5">
                <input type="submit" value="Create" class="btn btn-success form-control add-to-cart" style="border:none;" />

            </div>
            </div>
        </div>

        <div>
        </div>
    </div>
</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}