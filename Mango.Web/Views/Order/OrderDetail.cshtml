@model OrderHeaderDto
@using Mango.Web.Utility
<form method="post">
    <br />
    <input asp-for="OrderHeaderId" hidden />
    <div class="container">
        <div class="card order-summary">
            <div class="card-header bg-dark text-light ml-0 ">
                <div class="container row order-summary-header">
                    <div class="col-12 d-none d-md-block col-md-6 pb-1 text-warning h3 order-label">
                        Order Summary
                    </div>
                    <div class="col-12 col-md-4 offset-md-2 text-right mt-2">
                        <a asp-action="OrderIndex" class="btn btn-warning form-control btn-sm button-sub">Back to Orders</a>
                    </div>
                </div>
            </div>
            <div class="card-body ">
                <div class="container rounded p-2">
                    <div class="row order-summary-main">
                        <div class="col-12 col-lg-6 pb-4">
                            <div class="row my-1 input-box">
                                <div class="col-3 label label-order-summary">Name</div>
                                <div class="col-9">
                                    <input asp-for="Name" readonly class="form-control input" />
                                </div>
                            </div>
                           
                            <div class="row my-1 input-box">
                                <div class="col-3 label label-order-summary">Phone</div>
                                <div class="col-9">
                                    <input asp-for="Phone" readonly class="form-control input" />
                                </div>
                            </div>

                            <div class="row my-1 input-box">
                                <div class="col-3 label label-order-summary">Email</div>
                                <div class="col-9">
                                    <input asp-for="Email" readonly class="form-control input" />
                                </div>
                            </div>
                            <div class="row my-1 input-box">
                                <div class="col-3 label label-order-summary">Order Date</div>
                                <div class="col-9">
                                    <input value="@Model.OrderTime.ToShortDateString()" readonly class="form-control input" />
                                </div>
                            </div>

                            @if (User.IsInRole(SD.RoleAdmin))
                            {
                                <div class="row my-1 input-box">
                                    <div class="col-3 label label-order-summary">Session ID</div>
                                    <div class="col-9">
                                        <input asp-for="StripeSessionId" readonly class="form-control input" />
                                    </div>
                                </div>
                                <div class="row my-1 input-box">
                                    <div class="col-3 label label-order-summary">Payment Intent ID</div>
                                    <div class="col-9">
                                        <input asp-for="PaymentIntentId" readonly class="form-control input" />
                                    </div>
                                </div>
                            }
                            <div class="row my-1 input-box">
                                <div class="col-3 label label-order-summary">Order Status</div>
                                <div class="col-9">
                                    <input asp-for="Status" readonly class="form-control input" />
                                </div>
                            </div>

                        </div>
                        <div class="col-12 col-lg-5 offset-lg-1 order-summary-right">
                            <h4 class="d-flex justify-content-between align-items-center mb-3 order-summary-label">
                                <span class="text-warning">Order Summary</span>
                            </h4>
                            <div class="order-summary-status-helper">
                                <label class="bg-info text-dark text-center form-control my-2 order-summary-status">Order Status - @Model.Status</label>
                            </div>
                            <ul class="list-group mb-3 actual-order-details">
                                @foreach(var detail in Model.OrderDetails){
                                <li class="list-group-item d-flex justify-content-between p-2 actual-order-list">
                                    <div class="row container actual-order-item">
                                        <div class="col-8">

                                            <h6 class="my-0 text-white-50 actual-order-name">@detail.ProductName</h6>
                                                <small class="text-muted actual-order-price">Price : @detail.Price.ToString("c")</small><br />
                                                <small class="text-muted actual-order-quantity">Quantity : @detail.Count</small>
                                        </div>
                                        <div class="col-4 text-end">
                                            <p class="text-success actaul-order-item-total">@((detail.Count * detail.Price).ToString("c"))</p>
                                        </div>
                                    </div>
                                </li>
                                }
                                <li class="list-group-item bg-primary actual-order-list">
                                    <div class="row container actual-order-total">
                                        <div class="col-6">
                                            <h5 class="text-white">TOTAL </h5>
                                        </div>
                                        <div class="col-6 text-end">
                                            <h5 class="text-white">@Model.OrderTotal.ToString("c")</h5>
                                        </div>
                                    </div>
                                </li>
                            </ul>

                            @if (User.IsInRole(SD.RoleAdmin))
                            {
                                @if (Model.Status == SD.Status_Approved)
                                {
                                    <button asp-action="OrderReadyForPickup" asp-route-orderId="@Model.OrderHeaderId" type="submit" class="btn btn-success form-control my-1">Ready for Pickup</button>
                                }
                                @if (Model.Status == SD.Status_ReadyForPickup)
                                {
                                    <button asp-action="CompleteOrder" asp-route-orderId="@Model.OrderHeaderId" type="submit" class="btn btn-success form-control my-1">Complete Order</button>
                                }

                                if (Model.Status == SD.Status_Approved || Model.Status == SD.Status_ReadyForPickup)
                                {
                                    <button asp-action="CancelOrder" asp-route-orderId="@Model.OrderHeaderId" type="submit" class="btn btn-danger form-control my-1">Cancel Order</button>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>


