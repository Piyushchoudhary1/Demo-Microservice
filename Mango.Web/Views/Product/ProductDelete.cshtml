@model ProductDto

<form asp-action="ProductDelete">
    <div class="container border p-3 login-container">
        <h1 class="text-white text-center login-header">Delete Product</h1>
        <input hidden asp-for="ProductId" />

        <div class="row">
            <div class="col-2">
                <label class="control-label pt-2 label"> Name</label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="Name" disabled class="form-control input" />
            </div>
            <div class="col-2">
                <label class="control-label pt-2 label" >Category Name</label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="CategoryName" disabled class="form-control input" />
            </div>
            <div class="col-2">
                <label class="control-label pt-2 label" >Description</label>
            </div>
            <div class="col-10 pb-3">
                <textarea asp-for="Description" disabled class="form-control input" rows="5" ></textarea>
            </div>
            <div class="col-2">
                <label class="control-label pt-2 label">Price</label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="Price" disabled class="form-control input" />
            </div>
            <div class="col-2">
                <label class="control-label pt-2 label" >ImageUrl</label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="ImageUrl" disabled class="form-control input" />
            </div>

            <div class="adjacent-buttons">
            <div class="col-5 offset-2">

                <a asp-action="ProductIndex" class="btn-primary btn form-control button-sub">Back to List</a>
            </div>
            <div class="col-5">
                    <input type="submit" value="Delete" class="btn btn-danger form-control add-to-cart" style="border:none;" />

            </div>
            </div>
        </div>

        <div>
        </div>
    </div>
</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}