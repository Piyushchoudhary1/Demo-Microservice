@model LoginRequestDto

<form method="post">
    <div class="container border login-container">
        <div class="row text-center">
            <h2 class="login-header">Login</h2>
            <p class="line"></p>
        </div>
        <div class="row">
            <div class="col-12 col-md-6 offset-md-3 pb-2">
                
                <p class="label">Email address</p>
                <input asp-for="UserName" class="form-control input" placeholder="Username..."/><br />
                <span asp-validation-for="UserName" class="text-danger" />
            </div>
            <div class="col-12 col-md-6 offset-md-3 pb-2">
                <p class="label">Password</p>
                <input asp-for="Password" class="form-control input" placeholder="Password..." /><br />
                <span asp-validation-for="Password" class="text-danger" />
            </div>
            <div class="col-12 col-md-6 offset-md-3 pb-2">
                <button type="submit" class="form-control btn btn-success button-login" value="Submit">Login</button>
            </div>
        </div>
    </div>

