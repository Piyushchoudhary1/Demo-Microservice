@model ProductDto

<form method="post">
    <input asp-for="ProductId" hidden />
    <div class=" pt-4">
        <div class="container prduct-details-card">
            <div class="card-body">
                <div class="container rounded p-2">
                    <div class="row product-details">
                        <div class="col-12 col-lg-4 p-1 text-center">
                            <img src="@Model.ImageUrl" style="border-radius:35px;" width="100%" class="rounded" />
                        </div>
                        <div class="col-12 col-lg-8">
                            <div class="card-header bg-dark text-light row" style="border-radius: 0px;">
                                <div class="col-12 col-md-6 prduct-details-helper">
                                    <h1 class="text-white product-name">@Model.Name</h1>
                                </div>
                                <div class="col-12 col-md-6 text-end product-details-helper">
                                    <p class="text-warning cost"> &#8377; @Model.Price INR</p>
                                </div>
                            </div>
                            <div class="row pl-3">

                                <div class="col-12 product-details-helper">
                                    <span class="badge bg-primary text-success p-3 border category-name">@Model.CategoryName</span>
                                    <p class="text-secondary pt-3 fig--3-text">@Html.Raw(Model.Description)</p>
                                </div>
                            </div>
                            <div class="row mx-0">
                                <input asp-for="Count" class="form-control input input-product-details" />
                                <span asp-validation-for="Count" class="text-danger"></span>
                            </div>
                            <div class="card-footer row bg-dark product-details-buttons">
                                <div class="col-12 col-md-6 pb-1 ">
                                    <a asp-action="Index" class="btn btn-success btn-square form-control btn-lg button-sub">Back to List</a>
                                </div>
                                <div class="col-12 col-md-6 ">
                                    <button type="submit" class="btn btn-primary form-control btn-lg product-details-button add-to-cart " style="border:none;">Add to Cart</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
        </div>
    </div>
</form>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}

